{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "${mod_license}",
  "icon": "assets/aetherium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.aetherium.fabric.AetheriumFabric"]
  },
  "mixins": ["aetherium.mixins.json"],
  "accessWidener": "aetherium.accesswidener",
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "~1.21.1",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "breaks": {
    "sodium": "*",
    "embeddium": "*",
    "vulkanmod": "*",
    "nvidium": "*",
    "optifabric": "*"
  },
  "suggests": {
    "iris": "*"
  },
  "custom": {
    "modmenu": { "links": { "modmenu.github": "https://github.com/entitybrian69-bit/aetherium" } }
  }
}
