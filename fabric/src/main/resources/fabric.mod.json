{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Aetherium contributors"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issue_tracker}"
  },
  "license": "${mod_license}",
  "icon": "assets/aetherium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.aetherium.fabric.AetheriumFabric"
    ],
    "modmenu": [
      "com.aetherium.fabric.AetheriumModMenu"
    ]
  },
  "mixins": [
    "aetherium-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
