+    private static boolean aetherium$aimingAtMob() {
+        final HitResult hit = Minecraft.getInstance().hitResult;
+        return hit != null && hit.getType() == HitResult.Type.ENTITY
+                && ((EntityHitResult) hit).getEntity() instanceof LivingEntity;
+    }
